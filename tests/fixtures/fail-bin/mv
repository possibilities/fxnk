#!/bin/bash

set -euo pipefail

count_file=${FXNK_TEST_MV_COUNT_FILE:?}
fail_at=${FXNK_TEST_MV_FAIL_AT:?}
count=0
if [ -f "$count_file" ]; then
    count=$(cat "$count_file")
fi
count=$((count + 1))
printf '%s\n' "$count" >"$count_file"
if [ "$count" -eq "$fail_at" ]; then
    exit 1
fi
exec /bin/mv "$@"
